# TCS NetMon configuration — EXAMPLE ONLY.
#
# The real file lives at /etc/netmon/netmon.conf (root-readable, 0640,
# owned by the netmon service user), OUTSIDE the repository. Override the
# path with the NETMON_CONF environment variable.
#
# NEVER commit a real credential, token, internal hostname-with-secret, or
# key into the repository, logs, or test fixtures (CLAUDE.md §4.6).
#
# This is stdlib configparser (INI) syntax. Values are read by
# netmon/config.py, which validates required keys and fails loud on missing
# secrets.
#
# Values are taken LITERALLY: string interpolation is switched off, so a `%` in
# a password is a `%` and must NOT be doubled. (With the default on, `%%` in a
# camera password was delivered as a single `%` and the camera answered 401 —
# fixed 2026-09-08. If you escaped a `%` as `%%` in an earlier config, undo it.)

[db]
# SQLAlchemy URL. Production is MariaDB via the PyMySQL driver; dev/test may
# use SQLite. Uncomment the MariaDB line and set real credentials for a
# production install (the driver ships in pyproject).
# url = mysql+pymysql://netmon:CHANGEME@db.internal/netmon?charset=utf8mb4
# A relative sqlite path resolves against the process working directory; when
# running as a service use an ABSOLUTE path in a writable dir, e.g.
# sqlite:////var/lib/netmon/netmon.db  (the deploy script sets this for you).
url = sqlite:///./netmon.db
# Apply pending migrations on app startup. Leave false in production and run
# the migrate runner deliberately during deploys.
auto_migrate = false

[web]
host = 127.0.0.1
port = 8080
# Mark the session cookie Secure and forbid the dev auth bypass. MUST be true
# behind TLS in production.
secure_cookies = false
# Opaque session lifetime, seconds.
session_ttl = 43200
# Base URL of the retained Zabbix UI. Powers the nav deep-links for domains
# Zabbix keeps (Servers; FortiGate until phase 11.x — spec 11 D1/D2). Leave
# empty to render those nav entries disabled instead.
# zabbix_url = https://zabbix.example.internal
# Base URL of the SSHEASY web SSH client (jerahl/ssheasy), embedded in an
# iframe from device detail pages ("SSH" button, operator/admin only). NetMon
# only builds a host/port target — credentials are entered in the terminal,
# never handled here. Leave empty to hide the affordance.
# ssheasy_url = https://ssheasy.example.internal

# CARTO Basemaps API key for the site map's raster tiles (spec 09).
#
# Without it CARTO stamps every tile "API KEY REQUIRED", which is what the map
# showed until 2026-09-08. Get a free key at carto.com/basemaps/apikey — the
# free tier is 5,000,000 tile requests a calendar month, in exchange for
# keeping the CARTO and OpenStreetMap attribution visible on the map (the map
# page renders it; do not remove it).
#
# This key reaches the browser through /api/meta, because it is a query
# parameter on a tile URL — there is no way to use it server-side. It still
# belongs here rather than in the repo: a committed key is in git history and
# indexed forever, and this one carries a quota and a no-sharing term.
#
# Empty → the map still works, watermarked, rather than losing its basemap.
# carto_api_key = REPLACE_WITH_CARTO_BASEMAPS_KEY
# Base URL of the PacketFence ADMIN UI (not the REST API base in [packetfence]
# — on a normal deployment those are different ports). Used to deep-link an
# endpoint as <packetfence_url>/admin/#/node/<mac> from AP and port detail.
# Empty → the "View in PacketFence" affordance is hidden.
# packetfence_url = https://packetfence.example.internal

[auth]
# Single sign-on: NetMon is a SAML 2.0 Service Provider; ClassLink is the IdP.
# No passwords are handled here and there is no directory bind. Register NetMon
# in the ClassLink admin console, then fill these from the IdP metadata.
#
# IdP (ClassLink):
# saml_idp_entity_id = https://idp.classlink.com/<tenant>
# saml_idp_sso_url   = https://idp.classlink.com/<tenant>/sso
# saml_idp_x509cert  = MIIC...    (IdP signing cert, base64, no PEM headers)
#
# SP (this NetMon install):
# saml_sp_entity_id  = https://netmon.tcs.k12.al.us/auth/saml/metadata
# saml_sp_acs_url    = https://netmon.tcs.k12.al.us/auth/saml/acs
# Optional SP signing key/cert (for signed AuthnRequests):
# saml_sp_cert = MIIC...
# saml_sp_key  = MIIE...
#
# Assertion attribute names ClassLink releases (defaults shown):
saml_role_attr = role
saml_group_attr = group_ids
# Map claim values -> NetMon role (comma-separated). Highest granted role wins.
# saml_role_admin = Administrator, District Admin
# saml_role_operator = Network Operator
# saml_role_viewer = Staff, Teacher
# Or map by group id:
# saml_group_admin = 1001
# saml_group_operator = 1002
#
# DIAGNOSTIC — discover what ClassLink actually releases. When true, the ACS
# endpoint (POST /auth/saml/acs) validates the assertion then renders a page
# listing every attribute name + value and the role it maps to, WITHOUT issuing
# a session. Log in via ClassLink, read off the real attribute names/values,
# fill in the saml_role_*/saml_group_* maps above, then set this back to false
# and restart. It cannot be a login backdoor (no session is minted), but leave
# it off in normal operation — the app logs a warning while it is on.
# saml_debug = false
#
# BREAK-GLASS LOCAL ACCOUNT — works when ClassLink/the network is down. The
# password is a PBKDF2 hash, never plaintext; generate it with:
#   python -m netmon.auth.local
# local_user = netmon-admin
# local_password_hash = pbkdf2_sha256$240000$...$...
# local_role = admin
#
# LOCAL DEVELOPMENT ONLY. When set (and secure_cookies=false), login is
# bypassed and every request is authenticated as this user/role. Refused when
# secure_cookies=true so it can never be enabled in production.
# dev_bypass_user = devadmin
# dev_bypass_role = admin

[security]
# Settings engine (docs/spec/12-settings-engine.md). Admins can override most
# settings from the web UI (#/settings); overrides live in the app_settings
# table on top of this file. THIS SECTION IS FILE-ONLY and gates that feature.
#
# Master key sealing write-only secrets (API tokens/passwords set from the
# web) before they touch the database. Required before any secret can be
# stored from the UI. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Rotating it invalidates stored secret overrides (re-enter them in the UI).
# settings_key = REPLACE_WITH_64_HEX_CHARS
#
# Master switch for the web write path (default false = read-only settings
# page). Reads never expose secrets either way.
# allow_web_edit = true

[poller]
# Native poller: fping ICMP sweep + snmpget sysUpTime. Read-only ground truth.
# Disabled by default (per-step reversibility); flip on when ready.
enabled = false
# Where the sweeps run. true = in-process supervised tasks (default).
# Set false when netmon-poller.service owns them: fping needs CAP_NET_RAW,
# which the hardened netmon.service deliberately does not grant
# (NoNewPrivileges=yes voids fping's file capability, and the
# CapabilityBoundingSet is empty). With false, `enabled` above still governs
# whether the poller runs at all, so /api/health reports it honestly.
# Not web-editable on purpose — see docs/runbooks/poller.md.
in_process = true
ping_interval_s = 60
snmp_interval_s = 300
# Device types the ICMP sweep skips (comma-separated; empty sweeps everything).
# Empty by default. Cameras were excluded while the device_down rule could read
# their ICMP silence as an outage — 193 of 2,649 never answer while Milestone
# reports them recording — and migration 023 scopes that rule by device type
# instead, so the sweep records the fact and the engine declines to misread it.
ping_exclude_device_types =

# Hysteresis: consecutive failures to declare DOWN / successes to declare UP.
fail_threshold = 3
ok_threshold = 2
# fping tuning (per-target).
fping_timeout_ms = 500
fping_retries = 1
# SNMP. Community is a SECRET — keep it only in this file, never in the repo.
snmp_version = 2c
# snmp_community = REPLACE_WITH_RO_COMMUNITY
snmp_timeout_s = 2
snmp_retries = 1
snmp_concurrency = 20

[snmp_inventory]
# Read-only SNMP inventory sweeps for the Switches dashboard (spec 10 §4).
# Owner-approved charter amendment 2026-07-15 (CLAUDE.md §1): snmpbulkwalk,
# still GET-only, still no Python SNMP library. Reuses the [poller] SNMP
# credentials/version above. Disabled by default (per-step reversibility).
enabled = false
# snmpbulkwalk_path = snmpbulkwalk
# Switches swept concurrently (bounded so a fleet sweep finishes in-interval).
concurrency = 8
# Skip switches the native poller currently reports as NOT answering SNMP.
# A silent host costs a full timeout (snmp_timeout_s x snmp_retries) on every
# OID root and returns nothing: measured 361s a pass on two such switches out
# of 157. Their inventory rows then age without refresh, which the UI badges
# honestly, and the sweep resumes on its own within one poll of the host
# answering again. Only a fresh, uncontested `snmp = down` verdict skips --
# never an unknown, a stale one, or a shared management address.
# Set false to sweep every registered switch regardless.
skip_snmp_down = true
# Hard budget (seconds) for ONE full run — all due sweeps across the fleet.
# The first run after startup has every sweep due at once and legitimately
# outlives ports_interval_s; overrunning an interval just delays the next
# tick, only this budget cancels the run. Size it from a measured
# `python -m netmon.poller.snmp_inventory --once` at your fleet size.
run_timeout_s = 900
# Per-sweep enable flags + cadence (seconds). Ports fastest; FDB heaviest/slowest.
sweep_ports = true
ports_interval_s = 120
sweep_poe = true
poe_interval_s = 300
sweep_fdb = true
fdb_interval_s = 900
# EDP = Extreme Discovery Protocol (native on EXOS; replaced LLDP here).
sweep_edp = true
edp_interval_s = 1800
sweep_vlans = true
vlans_interval_s = 3600
sweep_stack = true
stack_interval_s = 300
# ENTITY-MIB inventory (per-slot model/serial/EXOS version, fan/PSU presence).
sweep_entity = true
entity_interval_s = 3600

[xiq]
# ExtremeCloud IQ. Bearer token from XIQ Admin -> API Access Tokens.
# Store the token here, not in the repo. Read-only usage (CLAUDE.md §4.1).
enabled = false
# api_token = REPLACE_WITH_XIQ_API_TOKEN
base_url = https://api.extremecloudiq.com
# Phase 10.2 cycles (each independently disableable; ~1.3-1.6k calls/h total
# at fleet scale, well inside the 7,500/h tenant quota):
# status_interval_s = 180
detail_enabled = true
detail_interval_s = 300
# Radios come from their own endpoint (/devices/radio-information) — they are
# NOT on the device payload. deviceIds is required and limit caps at 50, so this
# costs ceil(APs / 50) calls per cycle: ~16 for 783 APs, ~192/h at 300 s. Raise
# the interval or flip it off if the shared tenant quota gets tight.
radios_enabled = true
radios_interval_s = 300
# The clients cycle stores usernames + MACs (PII — spec 10 Q8); flip off to
# stop persisting them (the XIQ page then shows counts from AP rows only).
clients_enabled = true
clients_interval_s = 600
ssids_enabled = true
ssids_interval_s = 1800

[packetfence]
enabled = false
# url = https://pf.internal:9999
# user = netmon-ro
# pass = REPLACE_WITH_PF_PASSWORD
verify_ssl = true
interval_s = 300

[milestone]
# Milestone XProtect API Gateway (Config/REST API). Read-only.
enabled = false
# host = milestone-gw.internal
# user = netmon-ro
# pass = REPLACE_WITH_MILESTONE_PASSWORD
scheme = https
client_id = GrantValidatorClient
verify_ssl = true
interval_s = 120
# Camera MAC/serial/firmware backfill. These live in
# /hardware/{id}/hardwareDriverSettings, which has no collection form — one
# request per hardware record, ~300ms each — so each cycle fetches at most this
# many of the records still missing a MAC. 150 at a 120s interval fills ~2,500
# hardware in about half an hour and then costs nothing, because the values are
# static and already known. Set to 0 to disable the backfill entirely; the rest
# of the cycle is unaffected and MACs already stored are kept.
identity_batch = 150
identity_concurrency = 6
# Live Events/State subscription (spec 20 S7). Default OFF.
#
# With this false, the cycle above opens the ESS socket once per interval, reads
# ~16,500 states out of one getState reply and closes it — so a camera that
# stops talking is invisible for up to `interval_s`. With it true, a supervised
# task holds the subscription open and applies camera `source_status` as the
# events arrive, reconnecting with back-off and re-applying a full snapshot each
# time it reconnects.
#
# Measured on this estate 2026-09-08: ~61 frames/s, ~200 events/s, of which over
# 99% are motion and recording churn that is deliberately dropped — only
# Communication* events move state. Deltas are coalesced and written once per
# `ess_live_flush_s`, never per event.
#
# The 120s snapshot keeps running either way and repairs anything the stream
# missed while reconnecting; both derive the same dimension from the same
# interface, so they agree, and `write_states` logs a transition only when a
# value actually moves.
ess_live = false
# How often staged deltas are written. Lower is fresher and chattier.
ess_live_flush_s = 5
# Reconnect if no frame arrives in this long. Higher than ws.py's 60s default on
# purpose: overnight the motion traffic that dominates the stream stops, and a
# 60s watchdog would force a needless 4 MB resync every minute until dawn.
ess_live_watchdog_s = 180

[threecx]
# 3CX v20 REST API (voice). Read-only. OAuth2 client-credentials.
enabled = false
# url = https://pbx.tcs.internal:5001
# client_id = REPLACE
# client_secret = REPLACE
verify_ssl = true
interval_s = 120

[rconfig]
# rConfig (config-backup freshness). HTTPS only; apitoken auth.
enabled = false
# url = https://rconfig.tcs.internal
# api_token = REPLACE_WITH_RCONFIG_APITOKEN
verify_ssl = true
interval_s = 600
# Backups older than this are 'stale' (default 7 days).
stale_after_s = 604800

[engine]
# Alert engine (Phase 6). Evaluates alert_rules against device_state.
# Disabled by default (per-step reversibility). Ships in SHADOW mode: logs
# would-be notifications to the notifications table, sends nothing, until the
# owner flips shadow=false at cutover (Phase 8).
enabled = false
interval_s = 30
shadow = true
# smtp_host = smtp.internal
# smtp_port = 25
# smtp_from = netmon@tuscaloosacityschools.com
# default_target = noc@tuscaloosacityschools.com

[history]
# Bounded 24 h history ring buffer (Phase 10.6). The ONLY sanctioned
# metric-series exception to the no-time-series charter (CLAUDE.md §2;
# owner-approved 2026-07-15). A sampler snapshots a curated set of aggregate +
# per-switch series into state_samples every interval_s and prunes anything
# older than retention_hours — a fixed rolling window, never long-term storage.
# Read-only over NetMon's own DB (no source calls). Disabled by default
# (per-step reversibility); enable to power the sparklines.
enabled = false
interval_s = 300
# Hard-capped at 24 in config — a larger value is refused, not clamped.
retention_hours = 24

[zabbix]
# Read-only connection for scripts/zabbix_export.py — the Phase 0 recon helper
# that pulls sites/groups/hosts from the retiring Zabbix 7.4 server to feed
# `netmon-seed --sites`. Not read by the app (no collector polls Zabbix); this
# section exists only so the export script can find the server without CLI
# flags. CLI flags and env vars ($ZABBIX_URL / $ZABBIX_TOKEN) override these.
# url = https://zabbix.tcs.internal
# Prefer an API token (Zabbix: Users > API tokens) scoped to a read-only user.
# token = REPLACE_WITH_ZABBIX_API_TOKEN
# Or username/password (a session token is fetched via user.login):
# user = monitoring-ro
# password = REPLACE

[actions]
# Operator write actions — the ONLY non-GET calls NetMon makes to a source
# (spec 11 D4, owner-approved 2026-07-28). Every attempt is recorded in
# `action_audit` before the call leaves, so a timeout still leaves evidence.
#
# Owner decision 2026-07-29: these ship ENABLED ("live on merge"). D4's signed
# design specified default-off with a dry-run first; the flags remain so any one
# action can be switched off without a deploy (§4.3). Restart the service or
# Apply in the settings UI after changing them.
enabled = true
# Per-action switches. PacketFence:
reevaluate_access = true
restart_port = true
# rConfig (runs a stored snippet on the switch) and XIQ:
poe_cycle = true
ap_reboot = true
# The stored rConfig snippet that bounces PoE on a port. NetMon never sends CLI
# text — only this id plus `port`/`member` substitutions — so the commands stay
# reviewable in rConfig. Confirmed as id 4 ("Cycle POE") on this deployment.
poe_snippet_id = 4
# Minimum role: operator or admin. `viewer` is refused at startup — a read-only
# role must never be able to reboot an AP.
min_role = operator

[camera_ops]
# Bulk camera operations — firmware update and (later) configuration change.
# Spec 20 S8, gate D11. THE MOST DANGEROUS THING NETMON CAN DO: a wrong image
# bricks a camera and costs a truck roll, so every default here is off.
#
# Not built yet beyond pre-flight and planning; there is no executor. These keys
# exist so the shape is reviewable before anything can send.
enabled = false
# Walks every check and records what it *would* do, sending nothing. Stays true
# until the owner has watched a batch behave on a lab/spare camera.
dry_run = true
# Per operation, because they carry different risk. The setting catalogue is
# deferred, so config_change has nothing to run yet.
config_change = false
firmware_update = false
#
# A PRIVILEGED camera account — by default NOT the read-only one in
# [camera_snapshot], which is documented as unable to change camera
# configuration. Both are SECRETS.
# user = netmon-ops
# pass = REPLACE_WITH_PRIVILEGED_CAMERA_PASSWORD
#
# Or borrow [camera_snapshot]'s account instead of provisioning a second one.
# Off by default and deliberately explicit — that section calls its credential
# read-only, so using it for writes has to be something somebody typed rather
# than a fallback that happens quietly. Setting both `user` and this is refused
# at load, so it is always unambiguous which account writes to a camera.
use_snapshot_credentials = false
#
# THE PROVING GROUND, enforced rather than remembered. While this is set,
# pre-flight refuses every camera except this device id — whatever a batch asks
# for. It exists because deferring the setting catalogue means firmware is the
# first thing this machinery does, and the first live batches belong on one
# nominated camera rather than on a school.
#
# 0 = no restriction. Set an id while proving a new vendor, a new platform or a
# new image; clear it once one camera has gone through and verified. Note what
# clearing it changes: the canary stops being a camera somebody chose in advance
# and becomes the first camera of whatever batch is created.
proving_device_id = 0
#
# Vetted firmware images, one directory per vendor, outside the repo for the
# same reason credentials are. Each image is registered in `firmware_images`
# with a SHA-256 and a model allow-list; a push refuses any camera not on it.
#
# The store must be READABLE BY THE SERVICE USER. An image uploaded through the
# page is written by that user and is fine by construction; one dropped on disk
# by hand is not, and a root-owned 0640 file is what made the deploy button
# answer HTTP 500 on 2026-09-09. For a root-owned store:
#     chown -R root:netmon /var/lib/netmon/firmware
#     chmod -R g+rX       /var/lib/netmon/firmware
firmware_dir = /var/lib/netmon/firmware
#
# The ring discipline. Copied onto each batch at creation, so editing this file
# mid-roll cannot change the rules a running batch plays by.
# The canary runs ALONE and the batch stops until it verifies — it is the only
# thing between a bad image and the second camera. 0 is refused at load.
canary_count = 1
ring_size = 10
max_concurrent = 3
# Hard cap per batch. The fleet is 2,651, so a full roll is many batches by
# design — that is the point, not a limitation.
max_batch = 50
# Halt the batch when a ring's failure rate exceeds this percentage.
abort_pct = 10
# How long to wait for a camera to come back and report the new version.
reboot_timeout_s = 300
connect_timeout_s = 5
timeout_s = 120
# Cameras on the VMS network carry self-signed certificates, as with snapshots.
verify_ssl = false

[camera_snapshot]
# Camera still-image proxy (spec 11 D7, approved 2026-07-28; built spec 20 S4).
#
# Browsers strip embedded credentials from <img> subrequests, so a camera still
# cannot be fetched directly by the page. This proxies it server-side with a
# shared read-only camera account, which keeps the camera login off the browser
# entirely.
#
# Default OFF. It needs the account below, and it is the one place NetMon talks
# to a device while rendering a page rather than serving its own database —
# a deliberate, bounded relaxation of the zero-source-calls-at-render rule
# (CLAUDE.md §6). Turning `enabled` off returns those pages to DB-only with no
# deploy.
#
# SSRF posture: the proxy takes a NetMon `device_id`, never a URL or address,
# and resolves the target from the `cameras` row — so it can only ever reach an
# address Milestone registered for a camera.
enabled = false
# The shared read-only camera account (the same one ZCD used as
# {$TCS.CAM.USER} / {$TCS.CAM.PASS}). Read-only: this account must not be able
# to change camera configuration.
# user = netmon-ro
# pass = REPLACE_WITH_CAMERA_PASSWORD
#
# A second password for the SAME account, tried only after a camera answers 401
# to the one above. Both are taken literally — do not double a `%`. 2,651 cameras are not all on one password: a rotation
# reaches the cameras that were online for it, and the ones that were down, or
# were installed before it, still answer to the previous one. Optional — leave
# it out and exactly one credential is tried, as before. Also a SECRET.
# pass_backup = REPLACE_WITH_PREVIOUS_CAMERA_PASSWORD
#
# Cameras on the VMS network carry self-signed certificates. Named rather than
# hidden, because it is a real trade-off; the traffic stays inside the
# management network.
verify_ssl = false
connect_timeout_s = 3
timeout_s = 6
# A camera wall asks for up to 48 stills at once; without a cap that is 48
# simultaneous connections from this host to the camera VLAN.
max_concurrent = 8
# Browser cache lifetime for a still, in seconds.
cache_s = 5
# Vendor query parameter that selects which imager to photograph on a
# multi-camera device. EMPTY BY DESIGN: 178 cameras on this estate are one
# imager of several, and a bare snapshot path on such a device returns a
# *different imager's* picture — a plausible image of the wrong place, which
# nobody notices. Those cameras report "not configured" until this is confirmed
# against a real device. Bosch and Axis both count imagers from 1 while
# Milestone counts from 0; NetMon applies that offset.
# channel_param = channel
