# Template for /etc/netmon/netmon.env — NetMon's environment secrets.
#
# Install:
#   sudo install -o root -g netmon -m 0640 netmon.env.example /etc/netmon/netmon.env
#   sudo mkdir -p /etc/systemd/system/netmon.service.d
#   printf '[Service]\nEnvironmentFile=-/etc/netmon/netmon.env\n' | \
#     sudo tee /etc/systemd/system/netmon.service.d/env.conf
#   sudo systemctl daemon-reload && sudo systemctl restart netmon
#
# Format: KEY=value, one per line, no quotes. Never commit the filled-in file.

# ── Frontline Help Desk API (docs/spec/25-helpdesk.md) ──────────────────────
# Asset Management > Management > District Settings > API and SSO Information.
HD_API_KEY=
HD_API_PASSPHRASE=
